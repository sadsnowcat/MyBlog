---
import type { TermStat } from '../../lib/posts';

interface Props {
  tags: TermStat[];
}

const { tags } = Astro.props;

/**
 * Catppuccin 的 14 个强调色，按标签序号循环取色。
 * 这里只写入色板变量名，具体亮度由 CSS 按亮/暗模式处理：
 * 亮色会往正文色方向压一点保证可读，暗色直接用 Macchiato 的色值。
 */
const colors = [
  'var(--ctp-mauve)', 'var(--ctp-blue)', 'var(--ctp-teal)', 'var(--ctp-green)',
  'var(--ctp-peach)', 'var(--ctp-pink)', 'var(--ctp-sapphire)', 'var(--ctp-lavender)',
  'var(--ctp-red)', 'var(--ctp-yellow)', 'var(--ctp-sky)', 'var(--ctp-maroon)',
  'var(--ctp-flamingo)', 'var(--ctp-rosewater)',
];

const counts = tags.map((tag) => tag.count);
const maxCount = Math.max(1, ...counts);
const minCount = Math.min(...counts, maxCount);
const countRange = Math.max(1, maxCount - minCount);
const weightOf = (count: number) => (count - minCount) / countRange;
---

<section
  class:list={['p-cloud', tags.length <= 12 && 'is-small']}
  aria-label="全部标签"
  style={`--cloud-min: ${tags.length > 24 ? '560px' : '420px'}`}
>
  {
    tags.map((tag, index) => (
      <a
        class="p-cloud-tag"
        href={`/blog/tags/${tag.slug}/`}
        style={`--tag-color: ${colors[index % colors.length]}; --tag-weight: ${weightOf(
          tag.count,
        ).toFixed(3)}; --tag-tilt: ${((index % 7) - 3) * 1.35}deg;`}
        title={`${tag.name} · ${tag.count} 篇`}
      >
        <span>#{tag.name}</span>
        <small>{tag.count}</small>
      </a>
    ))
  }
</section>
