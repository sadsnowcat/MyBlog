---
import Icon from '../Icon.astro';

interface Props {
  current: number;
  total: number;
  /** 列表根路径，第 1 页为 base，第 N 页为 `${base}/page/N` */
  base: string;
}

const { current, total, base } = Astro.props;

const href = (page: number) => (page <= 1 ? (base || '/') : `${base}/page/${page}`);
---

{
  total > 1 && (
    <nav class="p-pager" aria-label="分页">
      {current > 1 ? (
        <a href={href(current - 1)}>
          <Icon name="arrow-left" size={14} />
          上一页
        </a>
      ) : (
        <span class="is-disabled">
          <Icon name="arrow-left" size={14} />
          上一页
        </span>
      )}

      <span class="p-page-count">
        {String(current).padStart(2, '0')} / {String(total).padStart(2, '0')}
      </span>

      {current < total ? (
        <a href={href(current + 1)}>
          下一页
          <Icon name="arrow-right" size={14} />
        </a>
      ) : (
        <span class="is-disabled">
          下一页
          <Icon name="arrow-right" size={14} />
        </span>
      )}
    </nav>
  )
}
