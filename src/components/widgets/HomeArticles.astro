---
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { sortBlogPostsForArchive } from '../../utils/content-dates';
import { getUiText } from '../../utils/ui-text';

interface Props {
  count?: number;
  excludeDraft?: boolean;
}

const { count = 6, excludeDraft = true } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ui = getUiText(await getSiteConfig());

function withBase(href: string) {
  if (href === '/') return `${basePath}/` || '/';
  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

const allPosts = await getCollection('blog', ({ data }) => (excludeDraft ? !data.draft : true));
const posts = sortBlogPostsForArchive(allPosts).slice(0, count);
const title = ui.locale.startsWith('zh') ? '文章' : 'Articles';
const moreLabel = ui.locale.startsWith('zh') ? '全部归档' : 'All posts';
---

<section class="articles-card" aria-label={title}>
  <div class="articles-head">
    <h2>{title}</h2>
    <a class="articles-more" href={withBase('/archives/')}>
      {moreLabel}
      <Icon name="external" size={14} />
    </a>
  </div>

  {
    posts.length > 0 ? (
      <ul class="articles-grid">
        {posts.map((post) => (
          <li>
            <a class="article-card" href={withBase(`/archives/${post.id}/`)}>
              <div class="article-top">
                <h3 class="article-title">{post.data.title}</h3>
                <time datetime={new Date(post.data.date).toISOString()}>
                  <FormattedDate date={post.data.date} />
                </time>
              </div>
              {post.data.description && <p class="article-desc">{post.data.description}</p>}
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="article-tags">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <span class="article-tag">#{tag}</span>
                  ))}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="articles-empty">还没有文章。</p>
    )
  }
</section>

<style>
  .articles-card {
    width: 100%;
  }

  .articles-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .articles-head h2 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .articles-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .articles-more:hover {
    color: var(--paper-accent);
  }

  .articles-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 16px 18px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: var(--paper-nav);
    color: var(--paper-ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .article-card:hover {
    border-color: var(--paper-accent);
    transform: translateY(-2px);
    box-shadow: var(--paper-shadow);
  }

  .article-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .article-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .article-card:hover .article-title {
    color: var(--paper-accent);
  }

  .article-top time {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--paper-ink-faint);
    white-space: nowrap;
  }

  .article-desc {
    margin: 8px 0 0;
    color: var(--paper-ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .article-tag {
    font-size: 0.72rem;
    color: var(--paper-ink-faint);
  }

  .articles-empty {
    margin: 0;
    color: var(--paper-ink-soft);
  }
</style>
