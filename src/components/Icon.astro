interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** 线条粗细 */
  strokeWidth?: number;
  /** 填充模式（品牌图标用） */
  fill?: boolean;
  'aria-hidden'?: boolean;
}

const { name, size = 18, class: className = '', strokeWidth = 1.8, fill = false, ...rest } = Astro.props;
const markup = icons[name] ?? '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor' : 'none'}
  stroke={fill ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['inline-block shrink-0', className]}
  aria-hidden="true"
  set:html={markup}
  {...rest}
/>
