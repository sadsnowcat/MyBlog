---
import Icon from './Icon.astro';
import { site } from '../config';

const year = new Date().getFullYear();
const range = year > site.footer.since ? `${site.footer.since} - ${year}` : `${year}`;
---

<footer class="mt-14 border-t border-line/60 py-10">
  <div class="content-container flex flex-col items-center gap-4 text-center">
    {
      site.social.length > 0 && (
        <div class="flex items-center gap-1.5">
          {site.social.map((item) => (
            <a
              href={item.url}
              class="icon-btn"
              aria-label={item.name}
              title={item.name}
              target={/^https?:/.test(item.url) ? '_blank' : undefined}
              rel={/^https?:/.test(item.url) ? 'noopener noreferrer' : undefined}
            >
              <Icon name={item.icon} size={17} />
            </a>
          ))}
        </div>
      )
    }

    <p class="text-sm text-ink-muted">
      © {range}
      <span class="mx-1 text-ink-faint">·</span>
      <span class="text-ink-soft">{site.author.name}</span>
      <span class="mx-1 text-ink-faint">·</span>
      <span>保留所有权利</span>
    </p>

    {
      site.footer.customText && (
        <p class="text-xs text-ink-muted" set:html={site.footer.customText} />
      )
    }

    {
      site.footer.showPoweredBy && (
        <p class="flex flex-wrap items-center justify-center gap-1.5 text-xs text-ink-muted">
          <span>Powered by</span>
          <a
            href="https://astro.build"
            class="text-ink-soft link-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Astro
          </a>
          <span class="text-ink-faint">·</span>
          <span>Theme</span>
          <a
            href="https://github.com/evannotfound/hexo-theme-redefine"
            class="text-ink-soft link-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Redefine
          </a>
        </p>
      )
    }
  </div>
</footer>
