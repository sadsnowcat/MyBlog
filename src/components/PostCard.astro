---
import Icon from './Icon.astro';
import { site } from '../config';
import { postExcerpt, postPath, type Post } from '../lib/posts';
import { formatDate, readingTime, slugify } from '../lib/utils';

interface Props {
  post: Post;
  /** 列表中的序号，用于错峰入场动画 */
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { data } = post;
const href = postPath(post);
const excerpt = postExcerpt(post);
const minutes = readingTime(post.body ?? '');
const cover = data.cover ?? (data as { banner?: string }).banner;
---

<li
  class="animate-fade-up"
  style={`animation-delay: ${Math.min(index, 8) * 45}ms`}
>
  <article class="card card-hover group relative flex h-full flex-col overflow-hidden">
    {
      cover && (
        <a
          href={href}
          class="relative block h-[160px] overflow-hidden sm:h-[190px] lg:h-[220px]"
          aria-hidden="true"
          tabindex="-1"
        >
          <img
            src={cover}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] dark:brightness-75"
          />
        </a>
      )
    }

    {
      data.sticky && (
        <span class="absolute right-3 top-3 z-10 inline-flex items-center gap-1 rounded-md border border-line bg-page-translucent px-2 py-0.5 text-[0.68rem] text-ink-muted backdrop-blur-sm">
          <Icon name="book" size={11} />
          置顶
        </span>
      )
    }

    <div class:list={['flex flex-1 flex-col gap-3 px-6 pb-5', cover ? 'pt-4' : 'pt-6']}>
      <h3 class="font-display text-[1.22rem] font-semibold leading-snug tracking-tight text-ink-strong">
        <a href={href} class="link-underline">{data.title}</a>
      </h3>

      <p class="line-clamp-3 text-[0.88rem] leading-relaxed text-ink-muted">{excerpt}</p>

      <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 pt-1 text-[0.76rem] text-ink-muted">
        <span class="inline-flex items-center gap-1">
          <Icon name="calendar" size={13} class="opacity-70" />
          <time datetime={data.date.toISOString()}>{formatDate(data.date, site.home.dateFormat, site.lang)}</time>
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="clock" size={13} class="opacity-70" />
          {minutes} 分钟
        </span>

        {
          site.home.showCategories && data.categories.length > 0 && (
            <span class="ml-auto flex flex-wrap items-center gap-1.5">
              {data.categories.map((category) => (
                <a href={`/blog/categories/${slugify(category)}/`} class="chip">
                  <Icon name="folder" size={11} />
                  {category}
                </a>
              ))}
            </span>
          )
        }
      </div>

      {
        site.home.showTags && data.tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            {data.tags.map((tag) => (
              <a href={`/blog/tags/${slugify(tag)}/`} class="chip">
                # {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </article>
</li>
