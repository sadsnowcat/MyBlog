---
import Icon from './Icon.astro';
import { site } from '../config';

const { navbar } = site;
const title = navbar.title ?? site.title;
const isActive = (path: string) => {
  if (path === '/') return Astro.url.pathname === '/';
  return Astro.url.pathname.startsWith(path);
};
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="navbar-gradient h-[var(--navbar-height)] w-full border-b border-white/10 shadow-sm backdrop-blur-[10px]">
    <nav
      class="mx-auto flex h-full max-w-[var(--navbar-width)] items-center justify-between px-5"
      aria-label="主导航"
    >
      <!-- 左：站点标题 -->
      <div class="flex min-w-0 items-center gap-2.5">
        {
          navbar.logo && (
            <a href="/" class="shrink-0" aria-label={title}>
              <img src={navbar.logo} alt="" class="h-8 w-8 rounded-sm object-cover" />
            </a>
          )
        }
        <a
          href="/"
          class="truncate font-display text-[1.55rem] font-[520] leading-none text-ink-strong transition-opacity hover:opacity-80"
        >
          {title}
        </a>
      </div>

      <!-- 中/右：导航链接 -->
      <ul class="hidden items-center gap-1 md:flex">
        {
          navbar.links.map((link) => (
            <li class="relative group">
              {link.submenu?.length ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      'flex items-center gap-1.5 rounded-md px-3 py-2 text-[0.94rem] transition-colors',
                      isActive(link.path)
                        ? 'text-ink-strong font-medium'
                        : 'text-ink-soft hover:text-ink-strong',
                    ]}
                    aria-haspopup="true"
                  >
                    {link.icon && <Icon name={link.icon} size={15} />}
                    {link.name}
                    <Icon name="chevron-down" size={13} class="opacity-60" />
                  </button>
                  <div class="invisible absolute left-0 top-full w-44 translate-y-1 pt-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                    <div class="card overflow-hidden p-1.5">
                      {link.submenu.map((sub) => (
                        <a
                          href={sub.path}
                          class="flex items-center justify-between rounded-sm px-3 py-2 text-sm text-ink-soft transition-colors hover:bg-primary/10 hover:text-primary"
                          target={sub.external || /^https?:/.test(sub.path) ? '_blank' : undefined}
                          rel={sub.external ? 'noopener noreferrer' : undefined}
                        >
                          {sub.name}
                          {/^https?:/.test(sub.path) && <Icon name="external" size={13} class="opacity-50" />}
                        </a>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={link.path}
                  class:list={[
                    'flex items-center gap-1.5 rounded-md px-3 py-2 text-[0.94rem] transition-colors',
                    isActive(link.path)
                      ? 'text-ink-strong font-medium'
                      : 'text-ink-soft hover:text-ink-strong',
                  ]}
                  target={link.external || /^https?:/.test(link.path) ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  aria-current={isActive(link.path) ? 'page' : undefined}
                >
                  {link.icon && <Icon name={link.icon} size={15} />}
                  {link.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- 工具按钮 -->
      <div class="flex items-center gap-1">
        {
          site.search.enable && (
            <button
              type="button"
              class="icon-btn"
              data-search-open
              aria-label="搜索"
              title="搜索（Ctrl / ⌘ + K）"
            >
              <Icon name="search" size={18} />
            </button>
          )
        }
        {
          site.colors.toggle && (
            <button
              type="button"
              class="icon-btn"
              data-theme-toggle
              aria-label="切换明暗主题"
              title="切换明暗主题"
            >
              <!-- 用 span 包一层：Icon 自带 inline-block，会盖掉 hidden -->
              <span class="dark:hidden"><Icon name="sun" size={18} /></span>
              <span class="hidden dark:block"><Icon name="moon" size={18} /></span>
            </button>
          )
        }
        <a href="/rss.xml" class="icon-btn hidden sm:inline-grid" aria-label="RSS" title="RSS">
          <Icon name="rss" size={17} />
        </a>
        <button
          type="button"
          class="icon-btn md:hidden"
          data-menu-toggle
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={20} />
        </button>
      </div>
    </nav>
  </div>

  <!-- 移动端抽屉 -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 md:hidden"
    data-mobile-menu
  >
    <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" data-menu-close></div>
    <div
      class="card absolute inset-x-3 top-[calc(var(--navbar-height)+10px)] max-h-[70vh] overflow-y-auto p-2 transition-transform duration-200"
      role="dialog"
      aria-modal="true"
      aria-label="站点菜单"
    >
      <div class="mb-1 flex items-center justify-between px-3 pt-1">
        <span class="section-label">导航</span>
        <button type="button" class="icon-btn h-8 w-8" data-menu-close aria-label="关闭菜单">
          <Icon name="close" size={18} />
        </button>
      </div>
      {
        navbar.links.map((link) => (
          <a
            href={link.path}
            class:list={[
              'flex items-center gap-3 rounded-md px-4 py-3 text-[0.95rem] transition-colors',
              isActive(link.path) ? 'text-primary font-medium' : 'text-ink-soft hover:bg-primary/5',
            ]}
          >
            {link.icon && <Icon name={link.icon} size={16} />}
            {link.name}
          </a>
        ))
      }
    </div>
  </div>
</header>
