---
import { getSiteConfig } from '../../data/site';
import { getUiText } from '../../utils/ui-text';

interface Props {
  name: string;
  slug: string;
  count: number;
}

const { name, slug, count } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${basePath}/tags/${slug}/`;
const ui = getUiText(await getSiteConfig());
---

<a class="tag-card" href={href}>
  <span class="tag-hash" aria-hidden="true">#</span>
  <strong>{name}</strong>
  <span class="tag-count">{ui.groups.articleCount(count)}</span>
</a>

<style>
  .tag-card {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-surface);
    color: var(--paper-ink);
    text-decoration: none;
    box-shadow: var(--paper-shadow);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .tag-card:hover {
    border-color: var(--paper-accent);
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    transform: translateY(-1px);
  }

  .tag-hash {
    color: var(--paper-accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  strong {
    font-size: 1rem;
    font-weight: 650;
  }

  .tag-count {
    color: var(--paper-ink-faint);
    font-family: var(--font-meta);
    font-size: 0.76rem;
  }
</style>
