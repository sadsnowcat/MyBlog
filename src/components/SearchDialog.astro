---
import Icon from './Icon.astro';
import { site } from '../config';

/** 搜索弹窗：索引由构建期生成的 /search.json 提供，前端用 fuse.js 模糊匹配 */
---

{
  site.search.enable && (
    <dialog data-search-dialog class="search-dialog" aria-label="搜索文章">
      <div
        class="card mx-auto flex w-[min(660px,94vw)] flex-col overflow-hidden"
        style="background: var(--background-color-transparent-80)"
        data-search-panel
      >
        <div class="flex items-center gap-3 border-b border-line px-4">
          <Icon name="search" size={17} class="text-ink-muted" />
          <input
            type="search"
            data-search-input
            placeholder="搜索标题、摘要、标签…"
            class="h-13 w-full bg-transparent py-4 text-[0.95rem] text-ink outline-none placeholder:text-ink-faint"
            autocomplete="off"
            spellcheck="false"
            aria-label="搜索关键词"
          />
          <kbd class="hidden text-[0.68rem] text-ink-faint sm:block">Esc</kbd>
        </div>

        <div class="max-h-[58vh] min-h-[120px] overflow-y-auto p-2" data-search-body>
          <p class="px-3 py-6 text-center text-sm text-ink-muted" data-search-empty>
            输入关键词开始搜索
          </p>
          <ul class="flex flex-col gap-0.5" data-search-results></ul>
        </div>

        <div class="flex items-center justify-between border-t border-line px-3 py-2 text-[0.7rem] text-ink-faint">
          <span class="inline-flex items-center gap-1.5">
            <kbd>↑</kbd><kbd>↓</kbd> 选择
            <span class="mx-0.5">·</span>
            <kbd>Enter</kbd> 打开
          </span>
          <span data-search-count />
        </div>
      </div>
    </dialog>
  )
}

<style>
  .search-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 5vh 1rem;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .search-dialog[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  /* 隐藏 Chrome 自带的搜索清除按钮，换成统一的视觉 */
  .search-dialog input[type='search']::-webkit-search-cancel-button,
  .search-dialog input[type='search']::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }
  .search-dialog[open] > div {
    animation: fade-up 0.25s var(--ease-out-soft) both;
  }
</style>
