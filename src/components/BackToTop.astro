---
import Icon from './Icon.astro';
import { site } from '../config';

/** 右下角浮动工具：回到顶部 + 阅读进度 */
---

<div
  class="fixed bottom-5 right-4 z-40 flex flex-col items-center gap-2 opacity-0 transition-opacity duration-300 sm:right-6"
  data-side-tools
  aria-hidden="true"
>
  {
    site.layout.scrollProgress && (
      <div class="relative grid h-10 w-10 place-items-center text-[0.62rem] font-medium text-ink-muted" data-progress-ring>
        <svg class="absolute inset-0 -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
          <circle cx="18" cy="18" r="16" fill="none" stroke="var(--color-line)" stroke-width="2" />
          <circle
            cx="18"
            cy="18"
            r="16"
            fill="none"
            stroke="var(--primary-color)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-dasharray="100.53"
            stroke-dashoffset="100.53"
            data-progress-circle
          />
        </svg>
        <span data-progress-text>0</span>
      </div>
    )
  }

  <button
    type="button"
    class="icon-btn card h-10 w-10 !rounded-full"
    data-back-to-top
    aria-label="回到顶部"
    title="回到顶部"
  >
    <Icon name="arrow-up" size={18} />
  </button>
</div>
