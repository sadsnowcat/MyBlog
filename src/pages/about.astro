---
import { render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/content/ContentHeader.astro';
import { getPage } from '../lib/posts';

import '../styles/content.css';

const page = await getPage('about');
if (!page) {
  throw new Error('缺少 src/content/pages/about.md —— 关于页面需要这个文件');
}

const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} solid>
  <div class="p-page">
    <ContentHeader kicker="About" title={page.data.title} />

    <article class="p-sheet markdown-body">
      <Content />
    </article>
  </div>
</BaseLayout>
