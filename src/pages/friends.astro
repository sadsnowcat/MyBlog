---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/content/ContentHeader.astro';
import Icon from '../components/Icon.astro';
import { friends } from '../data/friends';

import '../styles/content.css';
---

<BaseLayout title="友链" description="常读的站点，和愿意互相留个入口的朋友。" solid>
  <div class="p-page">
    <ContentHeader kicker="Friends · Links" title="友链" />

    <ul class="p-friend-grid p-friend-grid--flat">
      {
        friends.map((friend) => (
          <li>
            <a class="p-friend" href={friend.url} target="_blank" rel="noopener noreferrer">
              <span class="p-friend-avatar">
                <span class="p-friend-letter">{friend.name.slice(0, 1)}</span>
                {friend.avatar && (
                  <img
                    src={friend.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    onerror="this.remove()"
                  />
                )}
              </span>

              <span class="min-w-0">
                <span class="p-friend-name">
                  {friend.name}
                </span>
                <span class="p-friend-desc">{friend.description}</span>
              </span>

              <Icon name="external" size={13} class="p-friend-go" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
