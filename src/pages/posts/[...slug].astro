---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Copyright from '../../components/Copyright.astro';
import PostNav from '../../components/PostNav.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import Sidebar from '../../components/Sidebar.astro';
import {
  collectTerms,
  getPosts,
  postExcerpt,
  postPath,
  relatedPosts,
  seriesOfPost,
  type Post,
} from '../../lib/posts';
import { site } from '../../config';
import { formatDate, readingTime, slugify } from '../../lib/utils';

// 只在文章页加载 KaTeX 样式（含字体），首页不会被拖累
import 'katex/dist/katex.min.css';
import '../../styles/content.css';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1],
      next: posts[index - 1],
      related: relatedPosts(post, posts, 3),
    },
  }));
};

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
  related: Post[];
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
const cover = post.data.cover;

// 文章页左侧复用首页的作者卡 / 公告 / 菜单，所以需要全站统计
const allPosts = await getPosts();
const tagCount = collectTerms(allPosts, 'tags').length;
const categoryCount = collectTerms(allPosts, 'categories').length;
const seriesList = seriesOfPost(post, allPosts);
// 移动端没有右侧栏，目录折叠在正文上方
const mobileToc = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= site.post.toc.maxDepth,
);
---

<BaseLayout
  title={post.data.title}
  description={postExcerpt(post, 160)}
  image={cover}
  type="article"
  publishedTime={post.data.date.toISOString()}
  solid
>
  <div class="content-container-wide page-shell">
    <a class="p-back" href="/blog/">
      <Icon name="arrow-left" size={13} />
      返回文章
    </a>

    <div
      class="grid gap-6 lg:grid-cols-[var(--sidebar-width)_minmax(0,1fr)] xl:grid-cols-[var(--sidebar-width)_minmax(0,1fr)_var(--toc-width)]"
    >
      <Sidebar postCount={allPosts.length} tagCount={tagCount} categoryCount={categoryCount} />

      <article class="card overflow-hidden">
        {
          cover && (
            <img
              src={cover}
              alt=""
              class="h-[220px] w-full object-cover sm:h-[300px] lg:h-[340px]"
              loading="eager"
            />
          )
        }

        <div class="px-6 pb-8 pt-7 sm:px-10">
          <p class="p-kicker">{post.data.categories[0] ?? site.blog.kicker}</p>
          <h1 class="p-article-title">{post.data.title}</h1>

          <div class="p-article-meta">
            <span class="p-meta-item">
              <Icon name="calendar" size={13} />
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date, 'YYYY-MM-DD', site.lang)}
              </time>
            </span>
            <span class="p-meta-item">
              <Icon name="clock" size={13} />
              约 {readingTime(post.body ?? '')} 分钟 · {(post.body ?? '').length} 字
            </span>
            {post.data.updated && (
              <span class="p-meta-item">更新于 {formatDate(post.data.updated, 'YYYY-MM-DD', site.lang)}</span>
            )}
            {seriesList.map((series) => (
              <span class="p-meta-item">
                <Icon name="book" size={13} />
                <a class="p-tag" href={`/blog/series/${series.slug}/`}>{series.name}</a>
                <span class="text-ink-faint">· 第 {series.index} / {series.count} 篇</span>
              </span>
            ))}
            {post.data.tags.map((tag) => (
              <a class="p-tag" href={`/blog/tags/${slugify(tag)}/`}>#{tag}</a>
            ))}
          </div>

          {
            site.post.toc.enable && mobileToc.length > 1 && (
              <details class="mt-6 rounded-md border border-line bg-surface/40 px-4 py-3 xl:hidden">
                <summary class="flex cursor-pointer items-center gap-1.5 text-[0.84rem] text-ink-soft">
                  <Icon name="list" size={14} />
                  目录
                </summary>
                <ul class="mt-3 flex flex-col gap-1.5 text-[0.84rem]">
                  {mobileToc.map((heading) => (
                    <li style={`padding-left: ${(heading.depth - 2) * 14}px`}>
                      <a href={`#${heading.slug}`} class="text-ink-muted transition-colors hover:text-primary">
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
        </div>

        <div class="markdown-body px-6 pb-8 sm:px-10">
          <Content />
        </div>

        <div class="px-6 pb-8 sm:px-10">
          <Copyright post={post} />
          <PostNav prev={prev} next={next} />
        </div>
      </article>

      <aside class="sticky top-[calc(var(--navbar-height)+20px)] hidden self-start xl:block">
        <div class="flex flex-col gap-4">
          {
            seriesList.slice(0, 1).map((series) => (
              <div class="card p-4">
                <p class="section-label mb-1">系列</p>
                <a
                  class="mb-2 block font-display text-[0.95rem] text-ink transition-colors hover:text-primary"
                  href={`/blog/series/${series.slug}/`}
                >
                  {series.name}
                </a>
                <ol class="flex flex-col gap-1.5">
                  {series.posts.map((item, index) => (
                    <li>
                      <a
                        href={postPath(item)}
                        class:list={[
                          'flex gap-2 text-[0.8rem] leading-snug transition-colors',
                          item.id === post.id
                            ? 'text-primary'
                            : 'text-ink-muted hover:text-primary',
                        ]}
                      >
                        <span class="shrink-0 font-mono text-[0.7rem] opacity-60">
                          {String(index + 1).padStart(2, '0')}
                        </span>
                        <span class="line-clamp-2">{item.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }

          <Toc headings={headings} />

          {
            related.length > 0 && (
              <div class="card p-4">
                <p class="section-label mb-2">相关文章</p>
                <ul class="flex flex-col gap-2">
                  {related.slice(0, 3).map((item) => (
                    <li>
                      <a
                        href={postPath(item)}
                        class="line-clamp-2 text-[0.82rem] leading-snug text-ink-muted transition-colors hover:text-primary"
                      >
                        {item.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-4 font-display text-lg font-semibold text-ink-strong">继续阅读</h2>
          <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {related.map((item, index) => (
              <PostCard post={item} index={index} />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
