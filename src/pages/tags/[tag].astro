---
import type { GetStaticPaths } from 'astro';

import { collectTerms, getPosts } from '../../lib/posts';
import { site } from '../../config';

// /tags/<tag> 已并入文章区：这里只做一次静态跳转到 /blog/tags/<tag>
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return collectTerms(posts, 'tags').map((tag) => ({
    params: { tag: tag.slug },
    props: { target: `/blog/tags/${tag.slug}` },
  }));
};

interface Props {
  target: string;
}

const { target } = Astro.props;
const href = new URL(target, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <title>跳转中…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={href} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p>这个页面已经搬到 <a href={target}>{target}</a>。</p>
  </body>
</html>
